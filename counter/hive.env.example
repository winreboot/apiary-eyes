# One file per hive: /opt/beecounter/<hive>.env  ->  systemctl enable --now beecounter@<hive>
STREAM_URL=http://192.168.1.185:8090/stream
HIVE=hive2
INFLUX_URL=http://192.168.1.24:8086
INFLUX_ORG=beehive-org
INFLUX_BUCKET=beehive
INFLUX_TOKEN=paste-your-token-here
# counting line: 0.0 = top of frame, 1.0 = bottom
LINE_POS=0.5
# crossing the line in this direction counts as ENTERING (down|up)
IN_DIRECTION=down
# inference rate cap; the stream may be 25 fps, 10 is plenty for line crossing
PROC_FPS=10
CONF=0.25
